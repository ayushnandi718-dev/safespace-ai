# For a zero-config local demo, SQLite is used by default:
DATABASE_URL=sqlite+aiosqlite:///./safespace.db
# For production, uncomment and switch to PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/safespace
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
THERAPIST_API_KEY=
GOOGLE_MAPS_API_KEY=
IPGEOLOCATION_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_CONTACT=
CONFIRM_REAL_CALL=False
# Comma-separated or JSON-list of allowed browser origins:
CORS_ORIGINS=["http://localhost:3000"]
RENDER_API_KEY=